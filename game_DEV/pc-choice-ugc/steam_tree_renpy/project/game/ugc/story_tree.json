  "nodes": [
    {
      "id": "intro",
      "speaker": "시스템",
      "background": "menu_background.png",
      "text": {
        "ko": "방공호에 새로운 요청이 도착했습니다. 오늘의 결정을 시작하세요.",
        "en": "A new request reached the bunker. Start today's decision."
      },
      "choices": [
        {
          "id": "intro_accept",
          "text": {
            "ko": "요청을 받는다",
            "en": "Accept the request"
          },
          "next": "accept_path"
        },
        {
          "id": "intro_decline",
          "text": {
            "ko": "요청을 거절한다",
            "en": "Decline the request"
          },
          "next": "decline_path"
        }
      ]
    },
    {
      "id": "accept_path",
      "speaker": "지휘관",
      "text": {
        "ko": "좋아. 탐색팀을 꾸려서 바로 움직이자.",
        "en": "Good. Build a scout team and move now."
      },
      "choices": [
        {
          "id": "accept_safe",
          "text": {
            "ko": "안전 루트로 이동",
            "en": "Move through the safe route"
          },
          "next": "safe_result"
        },
        {
          "id": "accept_risk",
          "text": {
            "ko": "위험 루트로 단축 이동",
            "en": "Take the risky shortcut"
          },
          "next": "risk_result"
        }
      ]
    },
    {
      "id": "decline_path",
      "speaker": "기록관",
      "text": {
        "ko": "거절 처리했습니다. 대신 내부 자원을 정비합니다.",
