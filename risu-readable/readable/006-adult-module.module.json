        "out": "<div class=\"ero-status-wrapper\">\n<style>\n/* --- 접기/펼치기 및 버튼 스타일 (백그라운드 임베딩 대체) --- */\n.ero-status-details {\n    width: 100%;\n    margin: 10px 0;\n    font-family: 'Malgun Gothic', sans-serif;\n}\n\n.ero-status-details > summary {\n    list-style: none; /* 기본 삼각형 제거 */\n    cursor: pointer;\n    background: linear-gradient(135deg, rgba(61, 0, 61, 0.9), rgba(30, 0, 30, 0.95));\n    border: 1px solid #5e4b56;\n    color: #ffadaa;\n    padding: 10px 24px;\n    font-size: 14px;\n    font-weight: bold;\n    border-radius: 20px;\n    text-align: center;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.3);\n    transition: all 0.3s;\n    display: table; /* 중앙 정렬용 */\n    margin: 0 auto; /* 중앙 정렬 */\n    text-transform: uppercase;\n    letter-spacing: 1.5px;\n    position: relative;\n}\n\n/* Chrome/Safari 마커 숨김 */\n.ero-status-details > summary::-webkit-details-marker {\n    display: none;\n}\n\n.ero-status-details > summary:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 6px 15px rgba(255, 173, 173, 0.3);\n    border-color: #ffadaa;\n    background: linear-gradient(135deg, rgba(80, 0, 80, 0.9), rgba(50, 0, 50, 0.95));\n}\n\n.ero-status-details[open] > summary {\n    margin-bottom: 10px;\n    background: rgba(30, 0, 30, 0.95);\n    border-color: #ff8a85;\n}\n\n/* --- 기존 상태창 스타일 (필요한 부분만 압축) --- */\n.status-container-jaemin { \n    display: flex; flex-direction: column; \n    background: linear-gradient(135deg, #3a3238 0%, #212126 100%); \n    border: 1px solid #5e4b56; border-radius: 10px; \n    padding: 6px; gap: 6px; color: #e8e8e8; \n    box-shadow: 0 0 20px rgba(255, 173, 173, 0.12);\n    animation: fadeIn 0.4s ease-in-out;\n}\n@keyframes fadeIn { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }\n\n.status-header-jaemin, .status-footer-jaemin { \n    background-color: rgba(0, 0, 0, 0.25); border: 1px solid #5e4b56; \n    border-left: none; border-right: none; padding: 4px; text-align: center; \n}\n.status-header-jaemin { \n    font-size: 1.0em; font-weight: bold; color: #ffadaa; \n    border-top: none; border-radius: 5px 5px 0 0; margin: -6px -6px 0 -6px; \n}\n.status-footer-jaemin {\n    font-size: 0.75em; color: #c0c0c0; border-bottom: none;\n    border-radius: 0 0 5px 5px; margin: 0 -6px -6px -6px;\n}\n.status-content-wrapper-jaemin { display: flex; gap: 6px; }\n.stats-column-jaemin { flex: 1 1 31%; display: flex; flex-direction: column; gap: 5px; }\n.status-main-panel-jaemin { \n    flex: 1 1 38%; background-color: rgba(0, 0, 0, 0.5); \n    border: 1px solid #5e4b56; border-radius: 5px; overflow: hidden; \n    display: flex; align-items: center; justify-content: center;\n}\n.status-main-panel-jaemin img { width: 100%; height: 100%; object-fit: cover; }\n.stat-box-jaemin { \n    display: flex; gap: 6px; align-items: center;\n    background-color: rgba(50, 45, 55, 0.85); border: 1px solid #5e4b56; \n    border-radius: 4px; padding: 4px; transition: transform 0.3s; \n}\n.stat-box-jaemin:hover { transform: scale(1.02); border-color: #ffadaa; }\n.stat-icon-jaemin { \n    width: 42px; height: 42px; border: 1px dashed #5e4b56; \n    border-radius: 3px; display: flex; align-items: center; justify-content: center; \n    background: rgba(0,0,0,0.2); overflow: hidden; flex-shrink: 0;\n}\n/* 이미지 줌인 방지 픽스 */\n.stat-icon-jaemin img { width: 100%; height: 100%; object-fit: contain; }\n\n.stat-text-jaemin { flex-grow: 1; display: flex; flex-direction: column; justify-content: center; }\n.stat-text-jaemin h4 { \n    margin: 0 0 1px 0; font-size: 11px; color: #ffadaa; \n    border-bottom: 1px solid #5e4b56; font-weight: bold; \n}\n.stat-text-jaemin p { margin: 0; font-size: 10px; line-height: 1.2; word-break: keep-all; }\n.bot-thought { margin-top: 1px !important; font-style: italic; color: #c0c0c0; font-size: 9.5px !important; }\n\n.bot-card-jaemin { \n    flex-grow: 1; display: flex; flex-direction: column; \n    border: 1px solid #5e4b56; border-radius: 4px; backgroun