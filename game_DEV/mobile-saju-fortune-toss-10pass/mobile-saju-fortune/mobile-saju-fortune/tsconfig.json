{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["react", "react-native"],
    "paths": {
      "@saju/core": ["./packages/core/src/index.ts"],
      "@saju/core/*": ["./packages/core/src/*"],
      "@saju/data": ["./packages/data/src/index.ts"],
      "@saju/data/*": ["./packages/data/src/*"],
      "@saju/data/qna": ["./packages/data/src/qna.ts"]
    }
  },
  "include": [
    "index.ts",
    "require.context.ts",
    "src/**/*",
    "pages/**/*",
    "lib/**/*",
    "packages/core/src/**/*",
    "packages/data/src/**/*",
    "*.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".granite", "packages/tools"]
}
